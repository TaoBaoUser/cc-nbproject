{
  "name": "cc-nbproject",
  "version": "0.1.0",
  "description": "本地反向代理 + 桌面控制台：为 Claude Code 提供零重启的供应商切换",
  "main": "src/main/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "verify": "npm run typecheck && npm run lint && npm test",
    "e2e": "node scripts/e2e/run.js",
    "smoke": "node scripts/smoke.js",
    "postinstall": "node node_modules/electron/install.js"
  },
  "keywords": [
    "claude-code",
    "proxy",
    "electron",
    "llm-router"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "author": "TaoBaoUser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaoBaoUser/cc-nbproject.git"
  },
  "homepage": "https://github.com/TaoBaoUser/cc-nbproject#readme",
  "bugs": {
    "url": "https://github.com/TaoBaoUser/cc-nbproject/issues"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
